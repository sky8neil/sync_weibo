{
  "manifest_version": 3,
  "name": "双发小助手（饭否 + Akkoma + X）",
  "version": "0.4.1",
  "key": "",
  "description": "一键把消息发到饭否、自建 Akkoma 和 Twitter/X：支持图片（自动压 webp，Akkoma/X 均可带图）、#标签、实时字数、发送通知与错误日志。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "双发小助手"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "notifications"],
  "host_permissions": ["http://199.47.241.134/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
